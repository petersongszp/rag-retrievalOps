# 数据库（与 docker-compose 中 MySQL 一致；宿主机访问端口为 3307）
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent

# Redis（与 docker-compose 中 Redis 密码一致，默认 root）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# GitHub OAuth（redirect_url 需与 GitHub 应用里填写的 Authorization callback URL 一致）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:3000/github/callback

EMBEDDING_API_KEY = YOUR_API_KEY
EMBEDDING_MODEL = BAAI/bge-m3
EMBEDDING_BASE_URL = https://api.siliconflow.cn/v1

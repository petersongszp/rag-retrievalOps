DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent

# Redis（与 docker-compose 中 Redis 密码一致，默认 root）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root


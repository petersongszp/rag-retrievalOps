# MySQL: 使用 Docker 容器（端口 3307），配置需要和 docker-compose 一致
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent

# Redis: 使用 Docker 容器（端口 6379），配置需要和 docker-compose 一致
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# GitHub OAuth（redirect_url 需与 GitHub 应用里填写的 Authorization callback URL 一致）
# 请前往 GitHub Developer Settings 创建 OAuth App，
# 获取 Client ID 和 Client Secret，并将 Authorization callback URL 设置为你的目标地址（如 http://localhost:3000/github/callback）
GITHUB_CLIENT_ID=Your_GitHub_Client_ID
GITHUB_CLIENT_SECRET=Your_GitHub_Client_Secret
GITHUB_REDIRECT_URL=http://localhost:3000/github/callback

# Google OAuth（邮箱登录，redirect_url 需与 Google 云控制台「已授权的重定向 URI」一致）
# 请前往 Google Cloud Console 创建 OAuth 2.0 Client ID，
# 获取 Client ID 和 Client Secret，并将 Authorized redirect URIs 设置为你的目标地址（如 http://localhost:3000/google/callback）
GOOGLE_CLIENT_ID=Your_Google_Client_ID
GOOGLE_CLIENT_SECRET=Your_Google_Client_Secret
GOOGLE_REDIRECT_URL=http://localhost:3000/google/callback

# ========== LLM 大模型配置（核心：所有面试智能体使用此配置）==========
# LLM_PROVIDER_NAME 决定接入协议，支持的值:
#   OpenAI    → OpenAI 兼容协议 (openai, deepseek, ollama, qwen, groq, grok 等兼容接口)
#   Gemini    → Google Gemini 原生协议
#   Ark       → 火山引擎 Ark 协议 (doubao/豆包, volcengine)
#
# ---- 示例1: OpenAI 兼容协议 ----
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o
# LLM_PROVIDER_NAME=OpenAI
#
# ---- 示例2: Google Gemini 原生协议 ----
# LLM_API_KEY=AIzaSy...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL_NAME=gemini-2.5-flash
# LLM_PROVIDER_NAME=Gemini
#
# ---- 示例3: 火山引擎 Ark (豆包) ----
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL_NAME=doubao-seed-1-6-lite-251015
# LLM_PROVIDER_NAME=Ark
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_PROVIDER_NAME=OpenAI

# ASR 语音识别模型配置
OPENAI_ASR_BASE_URL=https://api.siliconflow.cn/v1
# 用于做语音修正的模型配置
OPENAI_ASR_MODIFY_LLM_MODEL=Qwen/Qwen3.5-4B
OPENAI_ASR_MODEL_NAME=FunAudioLLM/SenseVoiceSmall
OPENAI_ASR_API_KEY=sk-iutulmxhdpqdfovvpfaqesqrboceztrflpzttjnrgjtzpjzy

# ========== CozeLoop Trace（可选：仅在需要时启用，与 backend/config.yaml 中 CozeLoop 块对应；Enabled 需在 yaml 中设为 true）
# 官方环境变量名见 github.com/coze-dev/cozeloop-go const.go
COZELOOP_ENABLED=true
COZELOOP_API_BASE_URL=http://localhost:8888
COZELOOP_WORKSPACE_ID=
COZELOOP_API_TOKEN=
COZELOOP_SERVICE_NAME=mianshiba-backend
COZELOOP_DEPLOYMENT_ENV=local


# ========== Embedding（可选：仅在使用 RAG/专项面试知识库时需要）==========
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_REGION=cn-beijing

# ========== Milvus（可选：仅在使用向量检索时需要）==========
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=YOUR_USERNAME
MILVUS_PASSWORD=YOUR_PASSWORD

# ========== LiteLLM（可选：在需要接入链路监控时启用）==========
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-fWk39BRBv2GYHOuUI98olg889sYMXaKA
LITELLM_MASTER_KEY=sk-fWk39BRBv2GYHOuUI98olg889sYMXaKA
LITELLM_SALT_KEY=sk-ANJgKjm7vkrAqwuykQnNFfMogTtQh18S
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=litellm-admin-local
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=litellm_local_pwd

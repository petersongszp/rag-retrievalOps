# ========== 本地开发环境（模板）==========
# MySQL：使用 Docker 容器，端口 3307，配置需与 docker-compose 一致
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent

# Redis：使用 Docker 容器，端口 6379，配置需与 docker-compose 一致
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# ========== OAuth（可选）==========
# GitHub OAuth：redirect_url 需与 GitHub OAuth App 中 Authorization callback URL 一致
GITHUB_CLIENT_ID=Your_GitHub_Client_ID
GITHUB_CLIENT_SECRET=Your_GitHub_Client_Secret
GITHUB_REDIRECT_URL=http://localhost:3000/github/callback

# Google OAuth：redirect_url 需与 Google Cloud Console 中 Authorized redirect URI 一致
GOOGLE_CLIENT_ID=Your_Google_Client_ID
GOOGLE_CLIENT_SECRET=Your_Google_Client_Secret
GOOGLE_REDIRECT_URL=http://localhost:3000/google/callback

# ========== LLM 主模型配置（核心）==========
# LLM_PROVIDER_NAME 支持：OpenAI / Gemini / Ark
# 示例：
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1
# Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Ark:    LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o
LLM_PROVIDER_NAME=OpenAI

# ========== ASR 语音识别配置（可选）==========
OPENAI_ASR_BASE_URL=https://api.siliconflow.cn/v1
# 用于语音文本修正的模型
OPENAI_ASR_MODIFY_LLM_MODEL=Qwen/Qwen3.5-4B
OPENAI_ASR_MODEL_NAME=FunAudioLLM/SenseVoiceSmall
OPENAI_ASR_API_KEY=YOUR_SILICONFLOW_API_KEY_FROM_SILICONFLOW_CONSOLE

# ========== CozeLoop Trace（可选）==========
COZELOOP_ENABLED=true
COZELOOP_API_BASE_URL=http://localhost:8888
COZELOOP_WORKSPACE_ID=
COZELOOP_API_TOKEN=
COZELOOP_SERVICE_NAME=mianshiba-backend
COZELOOP_DEPLOYMENT_ENV=local

# ========== Embedding（可选，RAG 需要）==========
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_REGION=cn-beijing

# ========== Milvus（可选，RAG 需要）==========
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=YOUR_USERNAME
MILVUS_PASSWORD=YOUR_PASSWORD

# RAG 基础开关（L0）
APP_ENV=dev
RAG_ENABLED=true
RAG_ENABLE_PROD_GUARD=false
RAG_ENABLE_INGEST_RETRY=false
RAG_ENABLE_RETRIEVE_AUDIT=true
RAG_MAX_RETRY_COUNT=3
RAG_RETRY_BACKOFF_MS=500
RAG_RETRIEVE_TIMEOUT_MS=3000
RAG_USER_QPS_LIMIT=20
RAG_ENABLE_HYBRID_RETRIEVAL=false
RAG_ENABLE_QUERY_REWRITE=false
RAG_ENABLE_DYNAMIC_TOPK=false
RAG_ENABLE_ADVANCED_RERANK=false
RAG_HYBRID_DENSE_WEIGHT=0.7
RAG_HYBRID_SPARSE_WEIGHT=0.3
RAG_CANDIDATE_TOPK=10
RAG_MIN_TOPK=3
RAG_MAX_TOPK=8
RAG_REWRITE_TIMEOUT_MS=120
RAG_REWRITE_MAX_EXPANSIONS=3
RAG_RERANK_TIMEOUT_MS=250
RAG_RERANK_MODEL=jaccard-v1

# ========== LiteLLM（可选）==========
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=YOUR_LITELLM_VIRTUAL_KEY_FOR_CLIENT_CALLS
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY_FOR_ADMIN_APIS
LITELLM_SALT_KEY=YOUR_RANDOM_SALT_KEY_FOR_LITELLM_ENCRYPTION
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=litellm-admin-local
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=litellm_local_pwd

# SMTP 邮件服务（可选）
SMTP_HOST=smtp.xxx.com
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_EMAIL
SMTP_PASS=YOUR_SMTP_EMAIL_PASSWORD
SMTP_FROM=YOUR_SMTP_EMAIL # 一般和 SMTP_USER 相同

# ========== Admin 管理后台配置 ==========
# Admin 服务端口配置（可选，默认 3002）
ADMIN_PORT=3002
# Admin 服务的 API 地址（可选，Docker 环境默认 /api）
ADMIN_API_BASE_URL=/api

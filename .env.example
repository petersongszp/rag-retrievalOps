# Local development defaults

# MySQL
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=root

# Embedding
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_REGION=cn-beijing
# Ark 专用：当 EMBEDDING_PROVIDER=ark 且使用多模态 embedding endpoint 时填写 multimodal。
ARK_EMBEDDING_API_TYPE=

# Milvus
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=YOUR_USERNAME
MILVUS_PASSWORD=YOUR_PASSWORD

# RAG feature flags
APP_ENV=dev
RAG_ENABLED=true
RAG_ENABLE_PROD_GUARD=false
RAG_ENABLE_INGEST_RETRY=false
RAG_ENABLE_RETRIEVE_AUDIT=true
RAG_MAX_RETRY_COUNT=3
RAG_RETRY_BACKOFF_MS=500
RAG_RETRIEVE_TIMEOUT_MS=3000
RAG_USER_QPS_LIMIT=20
RAG_ENABLE_HYBRID_RETRIEVAL=false
RAG_ENABLE_QUERY_REWRITE=false
RAG_ENABLE_DYNAMIC_TOPK=false
RAG_ENABLE_ADVANCED_RERANK=false
RAG_HYBRID_DENSE_WEIGHT=0.7
RAG_HYBRID_SPARSE_WEIGHT=0.3
RAG_CANDIDATE_TOPK=10
RAG_MIN_TOPK=3
RAG_MAX_TOPK=8
RAG_REWRITE_TIMEOUT_MS=120
RAG_REWRITE_MAX_EXPANSIONS=3
RAG_RERANK_TIMEOUT_MS=250
RAG_RERANK_MODEL=jaccard-v1

# ========== Document Parser（本地 Docling HTTP Provider）==========
# 后端会把 PDF/DOCX/HTML 上传到这个 HTTP endpoint，并期待返回 NormalizedDocument JSON。
# 本地直接运行后端时常用 localhost；后端在 docker-compose 网络里运行时通常改成 http://parser-provider:9000/parse。
DOCUMENT_PARSER_PROVIDER=http
DOCUMENT_PARSER_ENGINE=docling
DOCUMENT_PARSER_ENDPOINT=http://localhost:9000/parse
DOCUMENT_PARSER_TIMEOUT_MS=60000
DOCUMENT_PARSER_STRICT_MODE=true
DOCUMENT_PARSER_SAVE_SIDECAR=true
OCR_PROVIDER=http
OCR_ENDPOINT=
OCR_TIMEOUT_MS=30000

# Docling Serve + parser-provider adapter（可选）
DOCLING_SERVE_IMAGE=quay.io/docling-project/docling-serve-cpu:latest
DOCLING_SERVE_PORT=5001
DOCLING_SERVE_ENABLE_UI=1
PARSER_PROVIDER_PORT=9000
DOCLING_BASE_URL=http://localhost:5001
DOCLING_TIMEOUT_MS=120000

# Admin UI
ADMIN_PORT=3002
ADMIN_API_BASE_URL=/api

# MCP server
MCP_ENABLED=false
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8898
MCP_ENDPOINT=/mcp
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
MCP_UPSTREAM_TIMEOUT_MS=5000
MCP_ENABLE_LEGACY_APP_ID=false

# MCP upstream and local stdio fallback
RAG_BASE_URL=http://localhost:8899
RAG_ACCESS_TOKEN=rag_local_debug_token

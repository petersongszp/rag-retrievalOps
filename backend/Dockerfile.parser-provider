# Local parser-provider adapter for Docling Serve.
FROM golang:1.25.1-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /app
COPY go.mod go.sum ./
ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct
ENV GOSUMDB=off
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -installsuffix cgo -o parser-provider ./cmd/parser-provider/main.go

FROM alpine:3.18
RUN apk add --no-cache ca-certificates tzdata curl

ENV TZ=Asia/Shanghai
RUN addgroup -g 1001 appuser && adduser -D -u 1001 -G appuser appuser

WORKDIR /app
COPY --from=builder /app/parser-provider .

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9000/healthz || exit 1

CMD ["./parser-provider"]

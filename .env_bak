# ========== 本地环境（备份版）==========
# MySQL：默认使用本地 Docker 映射端口 3307
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3307
DB_NAME=interview_agent

# Redis：本机无密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== Embedding（可选，RAG 需要）==========
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_REGION=cn-beijing

# ========== LiteLLM（可选）==========
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=YOUR_LITELLM_VIRTUAL_KEY_FOR_CLIENT_CALLS
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY_FOR_ADMIN_APIS
LITELLM_SALT_KEY=YOUR_RANDOM_SALT_KEY_FOR_LITELLM_ENCRYPTION
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=litellm-admin-local
LITELLM_POSTGRES_DB=litellm
LITELLM_POSTGRES_USER=litellm
LITELLM_POSTGRES_PASSWORD=litellm_local_pwd

# ========== CozeLoop Trace（可选）==========
COZELOOP_API_BASE_URL=http://localhost:18088
COZELOOP_WORKSPACE_ID=7617792883831078913
COZELOOP_API_TOKEN=YOUR_COZELOOP_API_TOKEN_FROM_COZELOOP_WORKSPACE
COZELOOP_SERVICE_NAME=mianshiba-backend
COZELOOP_DEPLOYMENT_ENV=local

# ========== Milvus（可选，RAG 需要）==========
MILVUS_ADDRESS=localhost:19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

# ========== 飞书告警（可选）==========
# FEISHU_WEBHOOK_URL=
